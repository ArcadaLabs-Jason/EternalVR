// Generated by CMake from data/input/controllers/*.toml; edit those files, not this one.

#include "game/eternal/controller_data.hpp"

namespace evr::game {

namespace {

constexpr std::string_view kOculusTouch = R"evrdata(@EVR_CONTROLLER_DATA_oculus_touch@)evrdata";
constexpr std::string_view kValveIndex = R"evrdata(@EVR_CONTROLLER_DATA_valve_index@)evrdata";

} // namespace

std::string_view controllerName(Controller controller) {
    switch (controller) {
    case Controller::ValveIndex:
        return "valve_index";
    case Controller::OculusTouch:
        break;
    }
    return "oculus_touch";
}

std::string_view builtinControllerData(Controller controller) {
    switch (controller) {
    case Controller::ValveIndex:
        return kValveIndex;
    case Controller::OculusTouch:
        break;
    }
    return kOculusTouch;
}

} // namespace evr::game
