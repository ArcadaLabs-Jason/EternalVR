// Generated by CMake from data/input/controllers/*.toml; edit those files, not this one.

#include "game/eternal/controller_data.hpp"

#include <cstddef>

namespace evr::game {

namespace {

struct BuiltinData {
    std::string_view name;
    std::string_view text;
};

// In the order of game::Controller.
constexpr std::array<BuiltinData, kControllerCount> kData{{
    {"oculus_touch", R"evrdata(@EVR_CONTROLLER_DATA_oculus_touch@)evrdata"},
    {"valve_index", R"evrdata(@EVR_CONTROLLER_DATA_valve_index@)evrdata"},
    {"hp_reverb_g2", R"evrdata(@EVR_CONTROLLER_DATA_hp_reverb_g2@)evrdata"},
    {"windows_mixed_reality", R"evrdata(@EVR_CONTROLLER_DATA_windows_mixed_reality@)evrdata"},
    {"htc_vive_cosmos", R"evrdata(@EVR_CONTROLLER_DATA_htc_vive_cosmos@)evrdata"},
    {"htc_vive_wand", R"evrdata(@EVR_CONTROLLER_DATA_htc_vive_wand@)evrdata"},
    {"pico4", R"evrdata(@EVR_CONTROLLER_DATA_pico4@)evrdata"},
}};

const BuiltinData& dataOf(Controller controller) {
    const auto index = static_cast<std::size_t>(controller);
    return kData[index < kData.size() ? index : 0];
}

} // namespace

std::string_view controllerName(Controller controller) {
    return dataOf(controller).name;
}

std::string_view builtinControllerData(Controller controller) {
    return dataOf(controller).text;
}

} // namespace evr::game
