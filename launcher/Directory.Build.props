<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.34</Version>
    <!-- Debug builds carry the -dev marker, so the launcher and layer version check only warns (VersionCheck). -->
    <Version Condition="'$(Configuration)' == 'Debug'">$(Version)-dev</Version>
    <!-- Debug builds carry the -dev marker, so the launcher and layer version check only warns (VersionCheck). -->
    <Version Condition="'$(Configuration)' == 'Debug'">$(Version)-dev</Version>
    <Company>ArcadaLabs</Company>
    <Product>EternalVR</Product>
  </PropertyGroup>
</Project>
