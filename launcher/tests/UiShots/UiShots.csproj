<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the launcher's windows and dialogs to PNG for visual QA (README.md next to this file). Not shipped. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>evr-ui-shots</AssemblyName>
    <RootNamespace>EternalVR.Launcher.UiShots</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The launcher's own DPI settings, so every window scales as it does in the launcher. -->
    <ApplicationManifest>..\..\src\EternalVR.Launcher\app.manifest</ApplicationManifest>
    <AppConfig>..\..\src\EternalVR.Launcher\App.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EternalVR.Launcher\EternalVR.Launcher.csproj" />
    <ProjectReference Include="..\..\src\EternalVR.Launcher.Core\EternalVR.Launcher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\data\*.txt" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\data\input\controllers\*.toml" Link="data\controllers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
